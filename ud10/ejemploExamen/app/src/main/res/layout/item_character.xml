<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp"
        >

        <ImageView
            android:id="@+id/ivImgCharacter"
            android:layout_width="@dimen/imgCharacter"
            android:layout_height="@dimen/imgCharacter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/txtContentDescriptionIvImgCharacter"
            />

        <TextView
            android:id="@+id/tvNameCharacter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/ivImgCharacter"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="10dp"
            android:text="@string/txtTvNameCharacter"
            android:textSize="18sp"
            android:textStyle="bold"
            />

        <TextView
            android:id="@+id/tvStatusCharacter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/ivImgCharacter"
            app:layout_constraintTop_toBottomOf="@id/tvNameCharacter"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:text="@string/txtTvStatusCharacter"
            android:textSize="16sp"
            />

        <TextView
            android:id="@+id/tvSpeciesCharacter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/ivImgCharacter"
            app:layout_constraintTop_toBottomOf="@id/tvStatusCharacter"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:text="@string/txtTvSpeciesCharacter"
            android:textSize="16sp"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>