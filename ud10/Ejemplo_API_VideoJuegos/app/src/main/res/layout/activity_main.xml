<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:padding="30dp">

    <EditText
        android:id="@+id/etBuscarJuego"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:inputType="text"
        android:autofillHints="name"
        android:hint="@string/txtEtHintBuscarJuego"
        />

    <Button
        android:id="@+id/btnBuscarJuego"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etBuscarJuego"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="10dp"
        android:text="@string/txtBtnBuscarJuego"
        />

    <TextView
        android:id="@+id/tvNombreDelJuego"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBuscarJuego"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="10dp"
        android:text="@string/txtTvNombreJuego"
        android:gravity="center"
        android:textSize="20sp"
        android:textStyle="bold"
        />

    <ImageView
        android:id="@+id/ivJuego"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNombreDelJuego"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="10dp"
        android:contentDescription="@string/txtContDescriptionJuego"
        />

</androidx.constraintlayout.widget.ConstraintLayout>