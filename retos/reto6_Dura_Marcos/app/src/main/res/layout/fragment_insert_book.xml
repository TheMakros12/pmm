<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragments.InsertBookFragment"
    android:padding="10dp">

    <EditText
        android:id="@+id/etNombreLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:hint="@string/txtHintEtNombreLibro"
        android:autofillHints="name"
        android:layout_marginTop="15dp"
        android:inputType="text"
        />

    <EditText
        android:id="@+id/etAutorLibro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etNombreLibro"
        app:layout_constraintEnd_toEndOf="parent"
        android:hint="@string/txtHintEtAutorLibro"
        android:autofillHints="name"
        android:layout_marginTop="15dp"
        android:inputType="text"
        />

    <Button
        android:id="@+id/btnInsertarLibro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etAutorLibro"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:text="@string/txtBtnInsertarLibro"

        android:textSize="16sp"
        android:textStyle="bold"
        />

</androidx.constraintlayout.widget.ConstraintLayout>